{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silurian.example/schemas/run_bundle/1.2.json",
  "title": "Silurian Forecast Diagnostic run bundle",
  "description": "A portable record containing client data. Reopening renders recorded results and never recomputes. Version 1.2 adds the routing result, required exactly when the manifest carries a routing stage.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest": {
            "properties": {
              "stages": {"contains": {"properties": {"stage": {"const": "classification"}}, "required": ["stage"]}}
            },
            "required": ["stages"]
          }
        }
      },
      "then": {"properties": {"results": {"required": ["classification"]}}}
    },
    {
      "if": {"properties": {"results": {"required": ["classification"]}}},
      "then": {
        "properties": {
          "manifest": {
            "properties": {
              "stages": {"contains": {"properties": {"stage": {"const": "classification"}}, "required": ["stage"]}}
            },
            "required": ["stages"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest": {
            "properties": {
              "stages": {"contains": {"properties": {"stage": {"const": "routing"}}, "required": ["stage"]}}
            },
            "required": ["stages"]
          }
        }
      },
      "then": {"properties": {"results": {"required": ["routing"]}}}
    },
    {
      "if": {"properties": {"results": {"required": ["routing"]}}},
      "then": {
        "properties": {
          "manifest": {
            "properties": {
              "stages": {"contains": {"properties": {"stage": {"const": "routing"}}, "required": ["stage"]}}
            },
            "required": ["stages"]
          }
        }
      }
    }
  ],
  "required": ["bundle_schema_version", "confidentiality", "manifest", "results", "integrity"],
  "additionalProperties": false,
  "properties": {
    "bundle_schema_version": {"type": "string", "enum": ["1.1", "1.2"]},
    "confidentiality": {
      "type": "object",
      "required": ["contains_client_data", "statement"],
      "additionalProperties": false,
      "properties": {
        "contains_client_data": {"type": "boolean", "const": true},
        "statement": {"type": "string", "minLength": 1},
        "source_filename": {"type": "string"}
      }
    },
    "manifest": {"type": "object", "required": ["schema_version", "run_id", "integrity"]},
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validation": {
          "type": "object",
          "required": ["verdict", "passes", "findings"],
          "additionalProperties": false,
          "properties": {
            "verdict": {"enum": ["accept", "accept_with_warnings", "reject"]},
            "passes": {"type": "array"},
            "findings": {"type": "array"},
            "transformations": {"type": "array"},
            "row_counts": {"type": "object"}
          }
        },
        "quality": {
          "type": "object",
          "required": ["portfolio_band", "headline", "per_sku", "findings"],
          "additionalProperties": false,
          "properties": {
            "portfolio_band": {"enum": ["clean", "caveated", "not_usable"]},
            "headline": {"type": "object"},
            "per_sku": {"type": "object", "additionalProperties": {"type": "object"}},
            "findings": {"type": "array"},
            "exceptions": {"type": "array"},
            "method_note": {"type": "string"}
          }
        },
        "classification": {
          "type": "object",
          "required": ["schema_version", "thresholds", "per_sku", "portfolio", "matrix", "method_note"],
          "additionalProperties": false,
          "properties": {
            "schema_version": {"type": "string"},
            "thresholds": {"type": "object"},
            "per_sku": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "not": {"anyOf": [{"required": ["band"]}, {"required": ["findings"]}]}
              }
            },
            "portfolio": {"type": "object"},
            "matrix": {
              "type": "object",
              "minProperties": 15,
              "maxProperties": 15,
              "additionalProperties": {
                "type": "object",
                "required": ["line_count", "volume_share_pct"]
              }
            },
            "method_note": {"type": "string", "minLength": 1}
          }
        },
        "routing": {
          "type": "object",
          "required": ["schema_version", "routing_table_version", "decisions", "precedence", "resolution_vocabulary", "per_sku", "portfolio", "method_note"],
          "additionalProperties": false,
          "properties": {
            "schema_version": {"type": "string"},
            "routing_table_version": {"type": "string"},
            "decisions": {"type": "object", "minProperties": 7, "maxProperties": 7},
            "precedence": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
            "resolution_vocabulary": {"type": "object"},
            "per_sku": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["decision", "reason", "forecast_eligible", "quality_band_at_decision", "refusal"],
                "not": {"anyOf": [{"required": ["band"]}, {"required": ["findings"]}]},
                "properties": {
                  "decision": {"enum": ["model_eligible", "model_eligible_wide_interval", "intermittent_methods", "policy_only", "insufficient_evidence", "refused_data_quality", "discontinued_confirm_status"]},
                  "reason": {"type": "string", "minLength": 1},
                  "forecast_eligible": {"type": "boolean"},
                  "quality_band_at_decision": {"enum": ["clean", "caveated", "not_usable"]},
                  "refusal": {
                    "type": ["object", "null"],
                    "required": ["code", "driven_by_finding_codes", "resolution_options"],
                    "properties": {
                      "code": {"enum": ["DISCONTINUED", "REFUSED_DATA_QUALITY", "INSUFFICIENT_EVIDENCE"]},
                      "driven_by_finding_codes": {"type": "array", "items": {"type": "string"}},
                      "resolution_options": {"type": "array", "items": {"type": "string"}, "minItems": 1}
                    }
                  }
                }
              }
            },
            "portfolio": {"type": "object"},
            "method_note": {"type": "string", "minLength": 1}
          }
        },
        "forecast": {
          "type": "object",
          "required": ["horizon", "series"],
          "additionalProperties": false,
          "properties": {
            "horizon": {"type": "integer", "minimum": 1},
            "series": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["points"],
                "properties": {
                  "points": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["period", "forecast"],
                      "properties": {
                        "period": {"type": "string", "format": "date"},
                        "forecast": {"type": "number"},
                        "lower": {"type": "number"},
                        "upper": {"type": "number"}
                      }
                    }
                  }
                }
              }
            },
            "excluded_series": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "required": ["attempted_at", "outcome"],
      "additionalProperties": false,
      "properties": {
        "attempted_at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["reproduced", "reproduced_within_tolerance", "differs", "not_comparable"]},
        "compared_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exact_stages": {"type": "array", "items": {"type": "string"}},
        "tolerant_stages": {"type": "array", "items": {"type": "string"}},
        "max_pct_diff": {"type": ["number", "null"]},
        "differences": {"type": "array", "items": {"type": "string"}}
      }
    },
    "integrity": {
      "type": "object",
      "required": ["bundle_sha256", "manifest_sha256", "content_fingerprint_sha256"],
      "additionalProperties": false,
      "properties": {
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
